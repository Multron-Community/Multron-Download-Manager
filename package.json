{
  "name": "multron-download-manager",
  "private": true,
  "version": "0.0.7",
  "license": "SEE LICENSE IN LICENSE",
  "description": "Multron Download Manager - Rust + Tauri desktop app",
  "scripts": {
    "setup": "npm install && npm --prefix frontend install",
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build",
    "build:debug": "tauri build --debug",
    "build:linux": "tauri build --bundles deb,rpm,appimage",
    "build:mac": "tauri build --bundles app,dmg",
    "build:windows": "node scripts/build-windows.mjs",
    "test": "node scripts/extension-builds.mjs && cargo test --manifest-path src-tauri/Cargo.toml",
    "check": "node scripts/extension-builds.mjs && cargo clippy --manifest-path src-tauri/Cargo.toml && npm --prefix frontend run check && npm run check:i18n",
    "check:i18n": "node scripts/i18n-check.mjs",
    "icons": "tauri icon src-tauri/icons/app-icon.png -o src-tauri/icons",
    "package:extension": "node scripts/package-extension.mjs",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.0"
  }
}
