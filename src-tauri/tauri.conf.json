{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Multron Download Manager",
  "mainBinaryName": "multron-download-manager",
  "version": "0.0.7",
  "identifier": "com.multron.downloadmanager",
  "build": {
    "beforeDevCommand": "node scripts/extension-builds.mjs && npm --prefix frontend run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "node scripts/extension-builds.mjs && npm --prefix frontend run build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Multron Download Manager",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 560,
        "center": true,
        "visible": false,
        "backgroundColor": "#161617"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https: http:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage",
      "dmg",
      "app"
    ],
    "category": "Utility",
    "shortDescription": "Fast multi-connection, media and torrent download manager",
    "longDescription": "Multron Download Manager is a fast, multi-connection download manager written in Rust with media downloads powered by yt-dlp, a built-in BitTorrent client, browser integration and SHA-256 verification.",
    "publisher": "Multron Community",
    "copyright": "Copyright (c) 2026 Multron Community. All rights reserved.",
    "license": "LicenseRef-Multron-EULA",
    "licenseFile": "../LICENSE",
    "homepage": "https://github.com/Multron-Community/Multron-Download-Manager",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "torrent"
        ],
        "name": "BitTorrent file",
        "description": "BitTorrent metainfo file",
        "mimeType": "application/x-bittorrent",
        "role": "Viewer"
      }
    ],
    "linux": {
      "deb": {
        "depends": [
          "libayatana-appindicator3-1"
        ],
        "recommends": [
          "ffmpeg"
        ],
        "section": "net",
        "priority": "optional"
      },
      "rpm": {
        "depends": [
          "libwebkit2gtk-4.1.so.0()(64bit)",
          "libgtk-3.so.0()(64bit)",
          "libayatana-appindicator3.so.1()(64bit)"
        ],
        "recommends": [
          "(ffmpeg or ffmpeg-free)"
        ],
        "release": "1"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "resources": {
      "../extension/": "browser-extension/",
      "../extension-build/firefox/": "browser-extension-firefox/"
    }
  }
}
