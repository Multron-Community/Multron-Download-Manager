{
  "manifest_version": 3,
  "name": "Multron Download Manager",
  "version": "0.0.10",
  "description": "Send downloads, videos (YouTube, Reddit, Instagram, X, TikTok…), Google Drive / MEGA files and torrents to Multron Download Manager.",
  "key": "",
  "homepage_url": "https://github.com/Multron-Community/Multron-Download-Manager",
  "permissions": [
    "contextMenus",
    "downloads",
    "storage",
    "cookies",
    "tabs",
    "notifications",
    "nativeMessaging",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Multron Download Manager",
    "default_popup": "popup.html",
    "default_icon": {
      "32": "icons/icon32.png",
      "64": "icons/icon64.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "32": "icons/icon32.png",
    "64": "icons/icon64.png",
    "128": "icons/icon128.png"
  }
}
